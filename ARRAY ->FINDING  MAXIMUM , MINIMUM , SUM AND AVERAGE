# include <stdio.h>
int main()
{
    int a[50], n, i;
    int max, min, sum = 0;
    float average;

    printf("Enter number of elements: ");
    scanf("%d", &n);
    printf("Enter elements:\n");
    for(i = 0; i < n; i++)
    {
        scanf("%d", &a[i]);
    }
    max = a[0];
    min = a[0];
    for(i = 0; i < n; i++)
    {
        sum = sum + a[i];
        if(a[i] > max)
            max = a[i];

        if(a[i] < min)
            min = a[i];
    }
    average = (float)sum / n;
    printf("\nMaximum = %d", max);
    printf("\nMinimum = %d", min);
    printf("\nSum = %d", sum);
    printf("\nAverage = %.2f", average);
    return 0;
}
